---
// Equipo: banda blanco roto. Cabeza partida (título y `texto`), `personas: [{nombre, cargo, foto, texto}]` en 4
// columnas con retratos 3:4 de borde inferior en diagonal y, al final, `galeria` (rutas) como franja de fotos de
// borde a borde y sin márgenes (el centro). Sin personas ni galería no se pinta.
import { seccion, cadena } from '../../data/site';
import { altGaleria } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const personas = (s?.personas ?? []).filter((p) => cadena(p.nombre));
const galeria = (s?.galeria ?? []).map(cadena).filter(Boolean).slice(0, 8);
---

{
  s && (personas.length > 0 || galeria.length > 0) && (
    <section id={Astro.props.id} class:list={['banda-fondo', galeria.length > 0 ? 'pt-[var(--ritmo)] md:pt-[var(--ritmo-md)]' : 'seccion']}>
      <div class="contenedor">
        {(s.antetitulo || s.titulo || s.texto) && (
          <div class="cabeza">
            <div>
              {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
              {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
            </div>
            {s.texto && <p class="text-[1.15rem] suave">{s.texto}</p>}
          </div>
        )}
        {personas.length > 0 && (
          <ul class="personas" style={`--n:${Math.min(personas.length, 4)}`}>
            {personas.map((p) => (
              <li>
                <div class="retrato">
                  <Imagen src={cadena(p.foto) || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={800} />
                </div>
                <h3 class="persona-nombre">{p.nombre}</h3>
                {cadena(p.cargo) && <p class="persona-cargo">{p.cargo}</p>}
                {cadena(p.texto) && <p class="mt-2 text-[.95rem] suave">{p.texto}</p>}
              </li>
            ))}
          </ul>
        )}
      </div>
      {galeria.length > 0 && (
        <div class="mosaico" style={`--n:${Math.min(galeria.length, 4)}`}>
          {galeria.map((g, i) => (
            <div>
              <Imagen src={g} alt={altGaleria(i)} ancho={800} alto={1000} />
            </div>
          ))}
        </div>
      )}
    </section>
  )
}
