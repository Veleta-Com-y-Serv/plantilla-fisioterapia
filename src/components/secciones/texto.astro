---
// Apartado de texto genérico (site.yaml: `tipo: texto`): banda petróleo muy claro a todo el ancho. Con `imagen`,
// fila 50/50 con la foto a sangre a la derecha (borde interior en diagonal); sin ella, titular grande a la izquierda
// y texto a la derecha. Admite `antetitulo`, `titulo`, `texto` (párrafos), `declaracion` (frase destacada),
// `items` ({titulo, texto, icono}) y `cta`.
import { seccion, parrafos, cadena, enlace, externo } from '../../data/site';
import { altSeccion } from '../../lib/seo';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const declaracion = cadena(s?.declaracion);
const foto = cadena(s?.imagen);
const items = (s?.items ?? []).filter((i) => cadena(i.titulo));
const cta = enlace(s?.cta);
---

{
  s && (
    <section id={Astro.props.id} class:list={['banda-clara', foto ? 'mitades' : 'seccion']}>
      <div class:list={[foto ? 'mitad mitad--izq' : 'contenedor grid gap-10 lg:grid-cols-12']}>
        <div class:list={[!foto && 'lg:col-span-6']}>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          {declaracion && <p class="declaracion">{declaracion}</p>}
        </div>
        <div class:list={[!foto && 'lg:col-span-6 lg:pt-10']}>
          {s.texto && (
            <div class="texto-lectura mt-8 max-w-[40rem] text-[1.1rem]">
              {parrafos(s.texto).map((p) => <p>{p}</p>)}
            </div>
          )}
          {items.length > 0 && (
            <ul class="mt-8 grid max-w-[40rem] gap-5">
              {items.map((it) => (
                <li class="flex items-start gap-4">
                  <span class="icono-caja"><Icono nombre={cadena(it.icono) || 'check'} tam={20} /></span>
                  <div>
                    <p class="condensada text-[1.35rem]">{it.titulo}</p>
                    {cadena(it.texto) && <p class="suave text-[.95rem]">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {cta && <a class="btn mt-9" href={cta.url} {...(externo(cta.url) && { rel: 'noopener', target: '_blank' })}>{cta.texto}</a>}
        </div>
      </div>
      {foto && (
        <div class="mitad-foto mitad-foto--der">
          <Imagen src={foto} alt={altSeccion(s)} ancho={1200} alto={1400} />
        </div>
      )}
    </section>
  )
}
